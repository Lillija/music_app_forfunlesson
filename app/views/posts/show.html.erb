<h1>🎵 Post</h1>

<div class="post-card">

  <% if @post.album&.cover_url.present? %>
    <img src="<%= @post.album.cover_url %>" class="post-img">
  <% end %>

  <h3>
    <%= @post.album&.name %> - <%= @post.album&.artist %>
  </h3>

  <p><%= @post.content %></p>

</div>

<%= link_to "← Back to Feed", posts_path, class: "btn" %>

<hr>

<h3>💬 Comments</h3>

<%= form_with model: [@post, Comment.new] do |f| %>
  <%= f.text_area :body %>
  <%= f.submit "Comment", class: "btn" %>
<% end %>

<% @post.comments.each do |comment| %>
  <p>💬 <%= comment.user.email %>: <%= comment.body %></p>
<% end %>