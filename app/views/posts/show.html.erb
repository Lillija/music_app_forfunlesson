<div class="post-card">

  <% if @post.album&.cover_url.present? %>
    <img src="<%= @post.album.cover_url %>" class="post-img">
  <% end %>

  <h2><%= @post.album&.name %> - <%= @post.album&.artist %></h2>

  <p><%= @post.content %></p>

  <hr>

  <h3>Reactions</h3>

  <% if @post.reactions.present? %>
    <% @post.reactions.each do |emoji, count| %>
      <span><%= emoji %> <%= count %></span>
    <% end %>
  <% else %>
    <p>No reactions yet.</p>
  <% end %>

  <div class="reaction-buttons">

    <%= link_to "👍",
                react_post_path(@post, emoji: "👍"),
                data: { turbo_method: :post },
                class: "btn" %>

    <%= link_to "❤️",
                react_post_path(@post, emoji: "❤️"),
                data: { turbo_method: :post },
                class: "btn" %>

    <%= link_to "😂",
                react_post_path(@post, emoji: "😂"),
                data: { turbo_method: :post },
                class: "btn" %>

  </div>

</div>

<hr>

<h2>Comments</h2>

<div class="comments-section">

  <% @post.comments.each do |comment| %>
    <div class="comment-card">

      <strong><%= comment.user.email %></strong>
      <p><%= comment.body %></p>

      <% if comment.user == current_user %>
        <%= link_to "Delete",
                    post_comment_path(@post, comment),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Delete comment?"
                    },
                    class: "btn" %>
      <% end %>

    </div>
  <% end %>

</div>

<hr>

<h3>Add a comment</h3>

<%= form_with(model: [@post, @comment]) do |f| %>
  <div>
    <%= f.text_area :body %>
  </div>

  <div>
    <%= f.submit "Comment", class: "btn" %>
  </div>
<% end %>