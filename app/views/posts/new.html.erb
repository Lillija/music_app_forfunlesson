<h1>New Music Post 🎵</h1>

<%= form_with model: @post do |f| %>

  <p>
    <%= f.label :Album_Name %><br>
    <%= f.text_field :album_name %>
  </p>

  <p>
    <%= f.label :Artist %><br>
    <%= f.text_field :artist %>
  </p>

  <p>
    <%= f.label :Album_Cover_Image_URL %><br>
    <%= f.text_field :image_url, placeholder: "Paste image link" %>
  </p>

  <p>
    <%= f.label :Your_Opinion %><br>
    <%= f.text_area :content %>
  </p>

  <%= f.submit "Post 🎵" %>

<% end %>