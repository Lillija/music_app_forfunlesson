<h1>New Post</h1>

<%= form_with model: @post do |f| %>
  <p>
    <%= f.label :album_name %><br>
    <%= f.text_field :album_name %>
  </p>

  <p>
    <%= f.label :artist %><br>
    <%= f.text_field :artist %>
  </p>

  <p>
    <%= f.label :image_url, "Album Cover URL" %><br>
    <%= f.text_field :image_url %>
  </p>

  <p>
    <%= f.label :content %><br>
    <%= f.text_area :content %>
  </p>

  <%= f.submit "Post 🎵", class: "btn" %>
<% end %>