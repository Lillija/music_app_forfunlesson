<h1>New Post</h1>

<%= form_with model: @post do |f| %>

  <%= f.label :title %><br>
  <%= f.text_field :title %><br><br>

  <%= f.label :artist %><br>
  <%= f.text_field :artist %><br><br>

  <%= f.label :image_url %><br>
  <%= f.text_field :image_url %><br><br>

  <%= f.label :content %><br>
  <%= f.text_area :content %><br><br>

  <%= f.submit "Post", class: "btn" %>
<% end %>