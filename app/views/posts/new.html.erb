<h1 class="page-title">🎵 Share a Track</h1>

<div class="form-card">
  <%= form_with model: @post do |f| %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title %>
    </div>

    <div class="form-group">
      <%= f.label :artist %>
      <%= f.text_field :artist %>
    </div>

    <div class="form-group">
      <%= f.label :image_url, "Album Cover URL" %>
      <%= f.text_field :image_url, placeholder: "Paste image link here" %>
    </div>

    <div class="form-group">
      <%= f.label :content %>
      <%= f.text_area :content %>
    </div>

    <%= f.submit "Post 🎶", class: "btn primary-btn" %>

  <% end %>
</div>