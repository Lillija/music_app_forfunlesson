<h1>🎵 Music Feed</h1>

<% if user_signed_in? %>
  <%= link_to "New Post", new_post_path, class: "btn" %>
<% end %>

<% @posts.each do |post| %>   <!-- 👈 THIS IS CRITICAL -->

  <div class="post-card">

    <div class="post-header">
      <strong><%= post.user.email %></strong>
    </div>

    <% if post.image_url.present? %>
      <img src="<%= post.image_url %>" class="post-img">
    <% end %>

    <h3><%= post.title %></h3>
    <p class="artist"><%= post.artist %></p>
    <p class="caption"><%= post.content %></p>

    <!-- ❤️ reactions -->
    <p>
      <% post.reactions.each do |emoji, count| %>
        <%= emoji %> <%= count %>
      <% end %>
    </p>

    <% if user_signed_in? %>
      <% ["👍", "❤️", "😂"].each do |emoji| %>
        <%= link_to emoji,
              react_post_path(post, emoji: emoji),
              data: { turbo_method: :post },
              class: "btn" %>
      <% end %>
    <% end %>

    <!-- 💬 comments -->
    <div class="comments-section">

      <% post.comments.each do |comment| %>
        <div class="comment-card">
          <strong><%= comment.user.email %>:</strong>
          <%= comment.content %>
        </div>
      <% end %>

      <% if user_signed_in? %>
        <%= form_with model: [post, Comment.new], local: true do |f| %>
          <%= f.text_field :content, placeholder: "Add a comment..." %>
          <%= f.submit "Post", class: "btn" %>
        <% end %>
      <% end %>

    </div>

  </div>

<% end %>   <!-- 👈 ALSO CRITICAL -->