<h1>🎧 Music Feed</h1>

<%= link_to "New Post", new_post_path, class: "btn" %>

<% @posts.each do |post| %>
  <div class="post-card">

    <% if post.album&.cover_url.present? %>
      <img src="<%= post.album.cover_url %>" class="post-img">
    <% end %>

    <h3>
      <%= post.album&.name %> - <%= post.album&.artist %>
    </h3>

    <p><%= post.content %></p>

    <%= link_to "View", post_path(post), class: "btn" %>

  </div>
<% end %>