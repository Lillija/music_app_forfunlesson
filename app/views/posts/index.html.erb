<h1>🎵 Music Feed</h1>

<% if user_signed_in? %>
  <%= form_with model: @post, local: true do |f| %>
    <div>
      <%= f.text_field :album_name, placeholder: "Album" %>
      <%= f.text_field :artist, placeholder: "Artist" %>
      <%= f.text_area :content, placeholder: "Write something..." %>
      <%= f.submit "Post", class: "btn" %>
    </div>
  <% end %>
<% end %>

<% @posts.each do |post| %>
  <div class="post-card">

    <h3><%= post.album_name %> - <%= post.artist %></h3>

    <p><%= post.content %></p>

    <div class="reaction-buttons">
      <% post.reactions.each do |emoji, count| %>
        <span><%= emoji %> <%= count %></span>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <div class="reaction-buttons">
        <%= link_to "👍", react_post_path(post, emoji: "👍"), data: { turbo_method: :post }, class: "btn" %>
        <%= link_to "❤️", react_post_path(post, emoji: "❤️"), data: { turbo_method: :post }, class: "btn" %>
        <%= link_to "😂", react_post_path(post, emoji: "😂"), data: { turbo_method: :post }, class: "btn" %>
      </div>
    <% end %>

    <% if user_signed_in? && post.user == current_user %>
      <%= link_to "Delete", post_path(post), data: { turbo_method: :delete }, class: "btn" %>
    <% end %>

  </div>
<% end %>